// O modelo de dados do Kikos CRM.
//
// `User` é a identidade única do sistema, tanto de quem faz login quanto de
// quem recebe Leads e Deals (ADR-0001). `Lead` é o contato comercial, `Deal` é
// a oportunidade de venda sobre ele, e `Comment` é a linha do tempo do Deal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

// A URL de conexão não mora mais aqui: desde o Prisma 7 ela fica em
// `prisma.config.ts` (para as migrations) e no adapter passado ao
// `PrismaClient` (para o runtime).
datasource db {
  provider = "postgresql"
}

/// O papel de um User. Rótulo para listar vendedores, não regra de acesso:
/// qualquer User autenticado enxerga e altera tudo (ADR-0001).
enum UserRole {
  MANAGER
  SELLER
}

/// A situação do relacionamento com o Lead. Vocabulário distinto do Stage do
/// Deal, e sincronizado pelas ações de Deal com a regra "último evento vence".
///
/// A ordem de declaração é a ordem do funil, e não é decorativa: um `ORDER BY`
/// sobre uma coluna `enum` no Postgres usa exatamente esta sequência, que é o
/// que faz a tabela ordenar por status de um jeito que significa alguma coisa.
enum LeadStatus {
  NEW
  CONTACT
  NEGOTIATION
  WON
  LOST
}

/// Onde o Deal está no Pipeline — a coluna do kanban.
///
/// A ordem de declaração é a ordem do funil, e é ela que um `ORDER BY` sobre a
/// coluna usa no Postgres. `CLOSED` é o último, e não é destino de movimentação:
/// chega-se nele marcando Ganho ou Perdido (ADR-0003).
enum DealStage {
  NEW
  CONTACT_MADE
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED
}

/// O desfecho do Deal. Ortogonal ao estágio: um diz onde o negócio está, o
/// outro diz se ele terminou e como (ADR-0003).
enum DealResult {
  OPEN
  WON
  LOST
}

/// A espécie de um Comment: escrito por uma pessoa ou gerado pelo sistema ao
/// registrar uma ação. As duas convivem na mesma tabela — a linha do tempo é
/// uma sequência só, e juntá-la na leitura custaria um merge por abertura.
enum CommentKind {
  USER
  SYSTEM
}

/// Por qual canal o Lead chegou ao time.
enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EVENT
  OUTBOUND
  OTHER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  /// Entra no payload do token e é conferido contra esta coluna a cada
  /// requisição. O logout incrementa o número, o que invalida de verdade todos
  /// os tokens daquele User — em vez de só pedir ao navegador que os esqueça
  /// (ADR-0004).
  tokenVersion Int @default(0)

  leads    Lead[]
  deals    Deal[]
  /// Os registros que esta pessoa assina na linha do tempo — inclusive os de
  /// sistema, que também têm autor.
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Um contato comercial — a pessoa e a empresa com quem se conversa. Existe
/// independentemente de haver negócio.
model Lead {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  company String

  /// **Não é único, de propósito.** Com remoção lógica, a linha apagada
  /// continuaria ocupando o índice e impediria recadastrar o mesmo contato
  /// depois.
  email String
  phone String

  /// O cargo do contato na empresa dele. Opcional no cadastro.
  jobTitle String?
  source   LeadSource
  status   LeadStatus @default(NEW)

  /// O vendedor responsável. Sem `onDelete`: o CRM não remove Users, e o
  /// default do Postgres (`RESTRICT`) é justamente a recusa que se quer se
  /// alguém tentar.
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  /// O campo livre do Lead. Comentário é coisa de Deal (ver CONTEXT.md).
  notes String?

  /// Um Lead pode ter vários Deals — é por isso que o negócio não é campo do
  /// contato. Sem `onDelete`: a remoção de Lead é lógica, e o Deal continua
  /// apontando para a linha.
  deals Deal[]

  /// O momento do último acontecimento relevante. Escrito pelas ações do
  /// domínio, não derivado do comentário mais recente.
  lastInteractionAt DateTime @default(now())

  /// Remoção lógica. O filtro que a respeita mora na camada de repositório,
  /// nunca nas rotas. Nasce aqui mesmo sem rota de remoção ainda, para não
  /// gerar uma migration extra na fatia que a implementa.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Os índices dos três recortes que a lista de Leads oferece. `deletedAt`
  /// entra em todos porque toda consulta começa excluindo os removidos.
  @@index([deletedAt, ownerId])
  @@index([deletedAt, status])
  @@index([deletedAt, lastInteractionAt])
  @@map("leads")
}

/// Uma oportunidade de venda concreta sobre um Lead, com um valor. Um Lead pode
/// ter vários Deals.
model Deal {
  id    String @id @default(uuid()) @db.Uuid
  title String

  /// **Inteiro em centavos, não `Decimal` nem ponto flutuante.** O `Decimal` do
  /// Prisma atravessa o JSON como string e complicaria o Schema; ponto
  /// flutuante perde centavo ao somar o funil no dashboard. O Schema
  /// compartilhado limita o valor a R$ 10.000.000,00, bem dentro do teto de um
  /// inteiro de 32 bits.
  valueInCents Int

  /// O contato de quem é o negócio.
  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  /// O vendedor responsável, que pode ser diferente do dono do Lead — quem
  /// prospecta nem sempre é quem fecha.
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  /// Onde o negócio está, e se ele terminou e como. As duas dimensões são
  /// ortogonais (ADR-0003), e o estado "estágio Fechado com resultado em
  /// aberto" é inalcançável por construção: encerrar preenche as duas de uma
  /// vez.
  stage  DealStage  @default(NEW)
  result DealResult @default(OPEN)

  /// O escopo negociado. Opcional no cadastro.
  description String?

  /// A data prevista de fechamento, informada por quem cadastra, e a data em
  /// que o negócio foi de fato encerrado, escrita pelo domínio junto do
  /// resultado.
  expectedCloseDate DateTime?
  closedAt          DateTime?

  /// O momento do último acontecimento relevante: criação, comentário, mudança
  /// de estágio ou fechamento. Escrito pelas ações do domínio.
  lastInteractionAt DateTime @default(now())

  /// A linha do tempo do negócio. Sem `onDelete`: a remoção de Deal é lógica, e
  /// o histórico continua apontando para a linha.
  comments Comment[]

  /// Remoção lógica, como no Lead. O filtro que a respeita mora na camada de
  /// repositório, nunca nas rotas.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Os recortes que o board e o dashboard pedem. `deletedAt` entra em todos
  /// porque toda consulta começa excluindo os removidos, e `stage` vem logo
  /// depois porque o board consulta coluna por coluna.
  @@index([deletedAt, stage, lastInteractionAt])
  @@index([deletedAt, ownerId])
  @@index([deletedAt, leadId])
  @@map("deals")
}

/// Um registro no histórico de um Deal, sempre atribuído a um User.
model Comment {
  id   String      @id @default(uuid()) @db.Uuid
  body String
  kind CommentKind

  /// **Obrigatório, e essa é a decisão.** Uma FK não-nulável em vez de chaves
  /// nuláveis ou de um par tipo/id: o banco garante a integridade, e nenhuma
  /// leitura precisa desambiguar a quem o registro pertence. Lead não recebe
  /// comentários — tem campo de observações (ver CONTEXT.md).
  dealId String @db.Uuid
  deal   Deal   @relation(fields: [dealId], references: [id])

  /// Quem assina o registro. Vale para as duas espécies: o de sistema é
  /// atribuído a quem executou a ação que o gerou.
  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id])

  /// **Não há `updatedAt` nem `deletedAt`, de propósito.** A linha do tempo é
  /// registro histórico: comentário não se edita nem se remove, e um registro
  /// de sistema muito menos. Uma coluna que não existe não tem como ser escrita
  /// por uma rota distraída.
  createdAt DateTime @default(now())

  /// O único recorte que existe: a linha do tempo de um negócio, do mais
  /// recente para o mais antigo.
  @@index([dealId, createdAt])
  @@map("comments")
}
