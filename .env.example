# Copie para `.env` na raiz do repositório: `cp .env.example .env`
# Um arquivo só serve o monorepo inteiro — docker compose, API e Vite leem daqui.

# --- Postgres (docker-compose) ---------------------------------------------
POSTGRES_USER=kikos
POSTGRES_PASSWORD=kikos
POSTGRES_DB=kikos_crm
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
# Precisa bater com as variáveis do Postgres acima.
DATABASE_URL=postgresql://kikos:kikos@localhost:5432/kikos_crm
API_PORT=3333
API_HOST=127.0.0.1
NODE_ENV=development

# --- Autenticação -----------------------------------------------------------
# Segredo que assina os tokens de sessão. Em desenvolvimento há um default;
# com NODE_ENV=production a API se recusa a subir sem esta variável.
JWT_SECRET=troque-este-segredo-em-producao

# Validade dos tokens, em segundos. Access curto mais renovação silenciosa
# (ADR-0004). Os defaults são 15 minutos e 7 dias.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# O `path` do cookie de refresh, que o restringe à rota que o consome.
# Inclui o prefixo `/api` porque o navegador fala com o Vite, e é a URL pedida
# ao Vite que o navegador compara com o `path` do cookie.
REFRESH_COOKIE_PATH=/api/auth/refresh

# Custo do bcrypt. O default é 10; a suíte de testes usa 4 sozinha, para não
# somar segundos por login. Subir este número encarece o ataque de força bruta
# e o próprio login, na mesma proporção.
BCRYPT_ROUNDS=10

# --- Web --------------------------------------------------------------------
# Porta do Vite. Em desenvolvimento ele proxia `/api` para a API acima,
# deixando navegador e servidor na mesma origem.
WEB_PORT=5173
