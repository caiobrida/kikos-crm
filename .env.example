# Copie para `.env` na raiz do repositório: `cp .env.example .env`
# Um arquivo só serve o monorepo inteiro — docker compose, API e Vite leem daqui.

# --- Postgres (docker-compose) ---------------------------------------------
POSTGRES_USER=kikos
POSTGRES_PASSWORD=kikos
POSTGRES_DB=kikos_crm
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
# Precisa bater com as variáveis do Postgres acima.
DATABASE_URL=postgresql://kikos:kikos@localhost:5432/kikos_crm
API_PORT=3333
API_HOST=127.0.0.1
NODE_ENV=development

# --- Web --------------------------------------------------------------------
# Porta do Vite. Em desenvolvimento ele proxia `/api` para a API acima,
# deixando navegador e servidor na mesma origem.
WEB_PORT=5173
